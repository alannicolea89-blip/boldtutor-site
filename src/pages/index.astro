---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import TrustBar from '../components/TrustBar.astro';
import Services from '../components/Services.astro';
import About from '../components/About.astro';
import StudentResults from '../components/StudentResults.astro';
import CTA from '../components/CTA.astro';
import { brand } from '../config/brand';
import { client } from '../data/client';
import { baseUrl } from '../utils/url';
---

<BaseLayout
  title="HSC English Tutor Sydney"
  description="One-on-one HSC English tutor in Sydney. English Advanced, Standard and Extension tutoring in Glebe, Liverpool, Mortdale and Western Sydney. No lock-in commitments."
  preloadImage={baseUrl('/shakespeare-hero.webp')}
  schema={{
    '@context': 'https://schema.org',
    '@type': ['LocalBusiness', 'EducationalOrganization'],
    name: client.name,
    telephone: client.phoneForTel,
    email: client.email,
    address: {
      '@type': 'PostalAddress',
      streetAddress: client.address.lineOne,
      addressLocality: client.address.city,
      addressRegion: client.address.state,
      postalCode: client.address.zip,
      addressCountry: client.address.country,
    },
    url: client.domain,
    areaServed: [
      { '@type': 'City', name: 'Sydney' },
      { '@type': 'City', name: 'Glebe' },
      { '@type': 'City', name: 'Liverpool' },
      { '@type': 'City', name: 'Mortdale' },
    ],
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: '5.0',
      reviewCount: '58',
      bestRating: '5',
      worstRating: '1',
    },
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'HSC Tutoring Services',
      itemListElement: [
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'HSC English Advanced Tutoring' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'HSC English Standard Tutoring' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Society and Culture PIP Tutoring' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Modern History Tutoring' } },
      ],
    },
  }}
>
  <Header slot="header" />

  <Hero
    topper="Private English Tutor — Sydney, Glebe, Liverpool & Western Sydney"
    heading="Ace HSC study with Boldtutor"
    description="Private English tutoring and HSC tutor support in Sydney. Online English tutor available nationwide. Face-to-face sessions in Glebe, Liverpool, Mortdale, and Western Sydney."
    ctaLabel="Request a Quote"
    ctaHref="https://wa.me/61416419270"
    secondaryLabel="View Subjects"
    secondaryHref={baseUrl('/subjects')}
    imageSrc={baseUrl('/shakespeare-hero.jpg')}
    imageAlt="English literature books and study materials for HSC tutoring"
  />

  <TrustBar items={[
    { label: 'From $55', value: 'Online' },
    { label: 'From $65', value: 'Face to Face' },
    { label: 'Session Lengths', value: '1hr+' },
    { label: 'Sydney Tutoring' },
  ]} />

  <Services
    topper="Subjects"
    heading="Study support tailored for you"
    description="Choose your subject and get personalised sessions focused on exam preparation, writing, and coursework outcomes."
    services={[
      {
        title: 'English',
        description: '',
        points: [
          'From $70 per hour face to face / $55 online',
          'Personalised sessions for you',
          'HSC essay writing',
          'HSC exam preparation',
          'Learn English language',
          'Yr K-10 English',
          'NAPLAN',
          'English Extension',
        ],
        icon: 'book',
        backgroundImage: baseUrl('/english-subject-tile.jpg'),
        href: baseUrl('/english-services'),
      },
      {
        title: 'Society & Culture',
        description: '',
        points: [
          'From $80 per hour in-person / $65 online',
          'PIP',
          'Personalised sessions for you',
          'HSC exam preparation',
          'Social Theory',
          'Research Methodologies',
          'Depth Studies',
        ],
        icon: 'society',
        backgroundImage: baseUrl('/society-subject-tile.jpg'),
        href: baseUrl('/subjects/society-and-culture'),
      },
      {
        title: 'Modern History',
        description: '',
        points: [
          'From $100 per hour for face to face / $85 for online',
          'Modern History HSC essay writing',
          'Personalised sessions for you',
          'HSC exam preparation',
          'Source analysis',
          'History yr 7-10',
        ],
        icon: 'history',
        backgroundImage: baseUrl('/history-subject-tile.jpg'),
        href: baseUrl('/subjects/modern-history'),
      },
    ]}
  />

  <!-- Family pricing callout -->
  <section class="py-10">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <div class="flex flex-col items-center justify-between gap-4 rounded-xl border border-accent/20 bg-accent/5 px-6 py-5 sm:flex-row">
        <div>
          <p class="font-semibold text-text">Family discount for more than one child</p>
          <p class="mt-1 text-sm text-text-muted">If you have two or more children in tutoring, you receive a discounted family rate. It applies across different year levels and subjects, so a primary school child and an HSC sibling both qualify. Message us on WhatsApp and we will tailor a rate for your family.</p>
        </div>
        <a
          href="https://wa.me/61416419270"
          class="shrink-0 inline-flex items-center gap-2 rounded-lg bg-accent px-5 py-2.5 text-sm font-bold text-accent-fg transition-opacity hover:opacity-90"
        >
          Message us on WhatsApp
          <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <About
    topper="Why Boldtutor?"
    heading="Private tutor support that reduces stress and builds confidence"
    body={[
      'Firstly, high school work and the year 12 HSC course may result in increased stress levels for high school students according to a 2019 study from Macquarie University.',
      'With this in mind, an effective approach to deal with this stress is to consider hiring me as your private English tutor or HSC tutor from Boldtutor. I offer exclusive HSC English resources, English tutoring, and dedicated guidance across Sydney — including Glebe, Liverpool, Mortdale, and Western Sydney — as well as online tutoring Australia-wide.',
    ]}
    benefits={[
      'Private tutor sessions starting from 1 hour',
      'Sydney tutoring at your desired location',
      'Exclusive resources and dedicated guidance',
      'Support for Four Paws Animal Welfare charity',
    ]}
    ctaLabel="Read About Boldtutor"
    ctaHref={baseUrl('/about')}
    imageSrc={baseUrl('/society-subject-tile.jpg')}
    imageAlt="Study materials for senior school tutoring and exam preparation"
  />

  <StudentResults
    ctaLabel="Request a Quote"
    ctaHref="https://wa.me/61416419270"
  />

  <CTA
    title="Book your session today"
    description="Ready to start? Message Boldtutor on WhatsApp and book your first session today."
    buttonText="Request a Quote"
    buttonHref="https://wa.me/61416419270"
  />

  <Footer slot="footer" />
</BaseLayout>
